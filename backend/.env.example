# 后端环境变量配置示例
# 复制此文件为 .env 并填写真实值

# 服务器端口
PORT=3000

# MongoDB连接字符串
MONGODB_URI=mongodb://localhost:27017/forum

# JWT密钥（请使用复杂的随机字符串）
JWT_SECRET=your-super-secret-key-change-in-production

# Token过期时间
JWT_EXPIRES_IN=7d

# 运行环境
NODE_ENV=development

# 前端URL（用于CORS）
FRONTEND_URL=http://localhost:5173
